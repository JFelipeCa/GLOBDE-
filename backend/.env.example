# URL completa del backend — SOLO úsala si NO quieres el proxy de Vite
# (por defecto déjala comentada: axiosClient usará '/api' y el proxy).
#
# En Codespaces, sin proxy, sería la dirección reenviada del puerto 8000
# con visibilidad "Public":
# VITE_API_URL=https://tu-codespace-8000.app.github.dev/api
#
# Local sin proxy:
# VITE_API_URL=http://localhost:8000/api





# Copia este archivo como .env y completa con tus valores locales.
# NUNCA subas el archivo .env real al repositorio.

DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=globde

FRONTEND_URL=http://localhost:5173
